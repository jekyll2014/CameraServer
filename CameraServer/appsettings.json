{
  "Urls": "http://0.0.0.0:8080",
  "AllowedHosts": "*",
  "Kestrel": {
    "Http": {
      "Port": 8080
    },
    "Https": {
      "Port": 8443,
      "CertPath": "/app/config/server.pem",
      "KeyPath": "/app/config/server.key"
    }
  },
  "CookieExpireTimeMinutes": 60,
  "ExternalHostUrl": "http://jekyll2024.mooo.com:8081",
  "ValidAudience": "CameraServer",
  "AllowBasicAuthentication": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
