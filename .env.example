# CameraServer Docker Environment Configuration

# ============================================================================
# WEB SERVER SETTINGS
# ============================================================================

# Web server port
WEB_PORT=8080

# HTTPS/SSL port
HTTPS_PORT=8443

# ASP.NET Core environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Production

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Cookie expiration time in minutes
COOKIE_EXPIRE_TIME=60

# Allow basic authentication (for API access)
ALLOW_BASIC_AUTH=true

# External host URL (for generating Telegram links, etc.)
EXTERNAL_HOST_URL=http://localhost:8080

# ============================================================================
# RESOURCE LIMITS
# ============================================================================

# CPU limit (in number of cores)
CPU_LIMIT=2

# Memory limit
MEMORY_LIMIT=2G

# CPU reservation
CPU_RESERVE=1

# Memory reservation
MEMORY_RESERVE=1G

# ============================================================================
# NGINX REVERSE PROXY SETTINGS (Optional)
# ============================================================================

# Nginx port (requires enabling nginx profile)
NGINX_PORT=80

# Nginx HTTPS port
NGINX_HTTPS_PORT=443

# ============================================================================
# LOGGING SETTINGS
# ============================================================================

# Log level (Verbose, Debug, Information, Warning, Error, Fatal)
SERILOG_LEVEL=Information

# ============================================================================
# TELEGRAM BOT SETTINGS
# ============================================================================

# Telegram Bot Token (leave empty to disable)
TELEGRAM_TOKEN=

# Telegram default video time in seconds
TELEGRAM_DEFAULT_VIDEO_TIME=30

# Telegram default video quality (0-100)
TELEGRAM_DEFAULT_VIDEO_QUALITY=90

# Telegram reconnect timeout in seconds
TELEGRAM_RECONNECT_TIMEOUT=10

# ============================================================================
# MOTION DETECTION SETTINGS
# ============================================================================

# Motion detection storage path (relative to /app/MotionRecords)
MOTION_STORAGE_PATH=./MotionRecords

# Motion detection default delay in ms
MOTION_DETECTOR_DELAY=1000

# Motion detection noise threshold (0-255)
MOTION_NOISE_THRESHOLD=80

# Motion detection change limit (0-100 as percentage)
MOTION_CHANGE_LIMIT=0.3

# ============================================================================
# VIDEO RECORDING SETTINGS
# ============================================================================

# Video storage path (relative to /app/Videos)
VIDEO_STORAGE_PATH=./Videos

# Video file length in seconds
VIDEO_FILE_LENGTH=300

# Default video quality (0-100)
VIDEO_QUALITY=90

# ============================================================================
# DOCKER BEHAVIOR
# ============================================================================

# Restart policy (no, always, unless-stopped, on-failure)
RESTART_POLICY=unless-stopped

# Enable health checks
ENABLE_HEALTH_CHECK=true

# Enable resource limits
ENABLE_RESOURCE_LIMITS=true
