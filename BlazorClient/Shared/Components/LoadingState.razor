@* Loading state component for consistent loading indicators across the application *@

@if (IsLoading)
{
    <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="pa-8">
        <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="@Color" />
        @if (!string.IsNullOrEmpty(Message))
        {
            <MudText Typo="Typo.body1">@Message</MudText>
        }
    </MudStack>
}

@code {
    /// <summary>
    /// Controls whether the loading indicator is displayed
    /// </summary>
    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>
    /// Message to display below the spinner
    /// </summary>
    [Parameter]
    public string Message { get; set; } = "Loading...";

    /// <summary>
    /// Color of the progress spinner
    /// </summary>
    [Parameter]
    public Color Color { get; set; } = Color.Primary;
}
