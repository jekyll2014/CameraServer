@layout MainLayout
@page "/"

@using CameraServer.Client.Pages.Panels
@using CameraServer.Client.Services
@using CameraServer.Shared

@inject IAuthenticationService _authenticationService

<PageTitle>CameraServer</PageTitle>

<MudText Typo="Typo.h2">CameraServer app</MudText>

<LoginPanel />

@if (!_authenticationService.IsAuthenticated)
{
    <MudText>Not logged in</MudText>
}
else
{
    <MudTabs>
        <MudTabPanel Text="Camera management">
            <MudPaper>
                <CameraManagementPanel />
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Motion detection">
            <MotionDetectionPanel />
        </MudTabPanel>

        <MudTabPanel Text="Recording">
            <RecordingPanel />
        </MudTabPanel>

        <MudTabPanel Text="Settings">
            <SettingsPanel />
        </MudTabPanel>

        <MudTabPanel Text="User info">
            <UserInfoPanel />
        </MudTabPanel>
    </MudTabs>
}

@code {

    protected override async void OnInitialized()
    {
        Console.WriteLine($"Index: OnInitialized()");

        _authenticationService.OnLogIn += OnLogin;
        _authenticationService.OnLogOut += OnLogout;
    }

    private async void OnLogin(UserInfoModel? userInfoModel)
    {
        Console.WriteLine("Index: OnLogin() invoked");
        try
        {
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Index: OnLogin() exception: {ex}");
        }
    }

    private void OnLogout()
    {
        Console.WriteLine("Index: OnLogout() invoked");

        StateHasChanged();
    }
}
