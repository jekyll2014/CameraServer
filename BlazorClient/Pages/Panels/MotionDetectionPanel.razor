@using System.Net
@using System.Net.Http.Json
@using CameraServer.Client.Services
@using CameraServer.Server.Services.MotionDetection
@using CameraServer.Shared
@using CameraServer.Shared.DTO
@using CameraServer.Shared.Enum

@inject HttpClient _http
@inject IAuthenticationService _authenticationService
@inject ICurrentUserState _currentUserState
@inject ILogger<MotionDetectionPanel> Logger
@inject IDialogService DialogService

<MudPaper Class="pa-4">
    <MudStack Spacing="4">
        <!-- Active Detectors Section -->
        <MudPaper Elevation="2" Class="pa-3">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h5">Active Motion Detectors</MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton OnClick="@ClickedRefresh"
                               Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="@_isLoading">
                        Refresh
                    </MudButton>
                    <MudButton OnClick="@(() => _showDetectorStream = !_showDetectorStream)"
                               Variant="Variant.Filled"
                               StartIcon="@(_showDetectorStream ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Videocam)"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               Disabled="@(_currentUserState.SelectedDetector == null)">
                        @(_showDetectorStream ? "Hide Stream" : "Show Stream")
                    </MudButton>
                </MudStack>
            </MudStack>

            <MudDivider Class="my-3" />

            @if (_isLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else if (_errorMessage != null)
            {
                <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">
                    @_errorMessage
                </MudAlert>
            }
            else
            {
                <MudStack Row="true" Spacing="4">
                    <!-- Detectors Grid -->
                    <div style="@(_showDetectorStream && _currentUserState.SelectedDetector != null ? "flex: 1;" : "width: 100%;")">
                        <MudDataGrid T="MotionDetectionCameraTask"
                                     Items="@(_currentUserState.Detectors ?? new List<MotionDetectionCameraTask>())"
                                     ReadOnly="true"
                                     Outlined="true"
                                     Dense="true"
                                     Hover="true"
                                     Striped="true"
                                     RowClick="@ClickedCameraRow"
                                     RowStyleFunc="@DetectorRowStyleFunc">
                            <NoRecordsContent>
                                <MudText Color="Color.Info">No active motion detectors. Create one below.</MudText>
                            </NoRecordsContent>

                            <Columns>
                                <TemplateColumn Title="Camera" Sortable="true">
                                    <CellTemplate>
                                        <MudText>@(_currentUserState.Cameras?.FirstOrDefault(n => n.Path == context.Item.CameraId)?.Name ?? "Unknown")</MudText>
                                    </CellTemplate>
                                </TemplateColumn>

                                <PropertyColumn Property="d => d.User" Title="User" Sortable="true" />

                                <PropertyColumn Property="d => d.CreationDateTime"
                                                Title="Started"
                                                Format="yyyy-MM-dd HH:mm:ss"
                                                Sortable="true" />

                                <TemplateColumn Title="Resolution" Sortable="false">
                                    <CellTemplate>
                                        @if (context.Item.FrameFormat.Width > 0)
                                        {
                                            <MudText>@context.Item.FrameFormat.Width x @context.Item.FrameFormat.Height</MudText>
                                        }
                                        else
                                        {
                                            <MudText Color="Color.Secondary">Original</MudText>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="Sensitivity" Sortable="false">
                                    <CellTemplate>
                                        <MudText>@context.Item.MotionDetectParameters?.ChangeLimit%</MudText>
                                    </CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="Actions" Sortable="false">
                                    <CellTemplate>
                                        <MudStack Row="true" Spacing="1">
                                            <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="@(() => ViewDetector(context.Item))"
                                                           Title="View Stream" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Stop"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => ClickedStop(context.Item))"
                                                           Title="Stop Detector" />
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    </div>

                    <!-- Detector Stream Iframe -->
                    @if (_showDetectorStream && _currentUserState.SelectedDetector != null)
                    {
                        <MudPaper Elevation="3" Class="pa-3" Style="flex: 1; min-width: 400px;">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.h6">
                                        @(_currentUserState.Cameras?.FirstOrDefault(n => n.Path == _currentUserState.SelectedDetector.CameraId)?.Name ?? "Detector Stream")
                                    </MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   OnClick="@(() => _showDetectorStream = false)" />
                                </MudStack>

                                <iframe src="@GetDetectorStreamUrl()"
                                        style="width: 100%; height: 500px; border: 2px solid #ddd; border-radius: 4px;"
                                        frameborder="0"
                                        allow="autoplay">
                                </iframe>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
        </MudPaper>

        <!-- Detector Details -->
        @if (_currentUserState.SelectedDetector != null)
        {
            <MudPaper Elevation="2" Class="pa-3">
                <MudText Typo="Typo.h6" Class="mb-3">Detector Details</MudText>

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudField Label="Camera" Variant="Variant.Outlined">
                            @(_currentUserState.Cameras?.FirstOrDefault(n => n.Path == _currentUserState.SelectedDetector.CameraId)?.Name ?? _currentUserState.SelectedDetector.CameraId)
                        </MudField>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudField Label="User" Variant="Variant.Outlined">
                            @_currentUserState.SelectedDetector.User
                        </MudField>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudField Label="Sensitivity (Change Limit)" Variant="Variant.Outlined">
                            @_currentUserState.SelectedDetector.MotionDetectParameters?.ChangeLimit%
                        </MudField>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudField Label="Noise Threshold" Variant="Variant.Outlined">
                            @_currentUserState.SelectedDetector.MotionDetectParameters?.NoiseThreshold
                        </MudField>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudField Label="Detector Delay (ms)" Variant="Variant.Outlined">
                            @_currentUserState.SelectedDetector.MotionDetectParameters?.DetectorDelayMs
                        </MudField>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudField Label="Started" Variant="Variant.Outlined">
                            @_currentUserState.SelectedDetector.CreationDateTime.ToString("yyyy-MM-dd HH:mm:ss")
                        </MudField>
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Notifications</b></MudText>
                        <MudSimpleTable Dense="true" Outlined="true">
                            <thead>
                                <tr>
                                    <th>Transport</th>
                                    <th>Type</th>
                                    <th>Destination</th>
                                    <th>Message</th>
                                    <th>Save Content</th>
                                    <th>Video Length (s)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var notification in _currentUserState.SelectedDetector.Notifications)
                                {
                                    <tr>
                                        <td>@notification.Transport</td>
                                        <td>@notification.MessageType</td>
                                        <td>@notification.Destination</td>
                                        <td>@notification.Message</td>
                                        <td>
                                            <MudChip T="string" Size="Size.Small" Color="@(notification.SaveNotificationContent? Color.Success: Color.Default)">
                                                @(notification.SaveNotificationContent ? "Yes" : "No")
                                            </MudChip>
                                        </td>
                                        <td>@notification.VideoLengthSec</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        <!-- Add New Detector Section -->
        <MudPaper Elevation="2" Class="pa-3">
            <MudText Typo="Typo.h6" Class="mb-3">Start New Motion Detector</MudText>

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="int"
                               @bind-Value="_selectedCameraId"
                               Label="Select Camera *"
                               Variant="Variant.Outlined"
                               Required="true"
                               Dense="true">
                        <MudSelectItem T="int" Value="-1">Select a camera...</MudSelectItem>
                        @foreach (var camera in _currentUserState.Cameras ?? new List<CameraDto>())
                        {
                            <MudSelectItem Value="@camera.Id">
                                @camera.Name (@camera.Type)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="FrameFormatDto"
                               @bind-Value="_newDetector.FrameFormat"
                               Label="Resolution"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Disabled="@(_selectedCameraId == -1)">
                        <MudSelectItem T="FrameFormatDto" Value="null">Original Resolution</MudSelectItem>
                        @foreach (var format in _currentUserState.Cameras?.FirstOrDefault(n => n.Id == _selectedCameraId)?.FrameFormats ?? Array.Empty<FrameFormatDto>())
                        {
                            <MudSelectItem Value="@format">
                                @($"{format.Width} x {format.Height} @@ {format.Fps} fps")
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Detection Parameters</b></MudText>
                </MudItem>

                <!-- Sensitivity Preset Selection -->
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="mb-3">Choose a sensitivity preset or customize advanced settings:</MudText>

                    <MudRadioGroup @bind-Value="SensitivityPreset" T="string">
                        <MudPaper Elevation="1" Class="pa-3 mb-2" Style="@(_sensitivityPreset == "low" ? "border: 2px solid var(--mud-palette-success);" : "border: 1px solid #ddd;")">
                            <MudRadio Value="@("low")" Color="Color.Success">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle1"><b>🟢 Low Sensitivity</b></MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Only detect major movements (people, vehicles)
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        ✓ Best for outdoor cameras • ✓ Windy areas • ✓ Fewer false alarms
                                    </MudText>
                                </MudStack>
                            </MudRadio>
                        </MudPaper>

                        <MudPaper Elevation="1" Class="pa-3 mb-2" Style="@(_sensitivityPreset == "medium" ? "border: 2px solid var(--mud-palette-primary);" : "border: 1px solid #ddd;")">
                            <MudRadio Value="@("medium")" Color="Color.Primary">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle1"><b>🔵 Medium Sensitivity (Recommended)</b></MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Balanced detection for most scenarios
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        ✓ Indoor cameras • ✓ General purpose • ✓ Good balance
                                    </MudText>
                                </MudStack>
                            </MudRadio>
                        </MudPaper>

                        <MudPaper Elevation="1" Class="pa-3 mb-2" Style="@(_sensitivityPreset == "high" ? "border: 2px solid var(--mud-palette-warning);" : "border: 1px solid #ddd;")">
                            <MudRadio Value="@("high")" Color="Color.Warning">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle1"><b>🟡 High Sensitivity</b></MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Detect even small movements (pets, shadows)
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Warning">
                                        ⚠️ May cause more false alarms • Best for controlled environments
                                    </MudText>
                                </MudStack>
                            </MudRadio>
                        </MudPaper>

                        <MudPaper Elevation="1" Class="pa-3 mb-2" Style="@(_sensitivityPreset == "custom" ? "border: 2px solid var(--mud-palette-secondary);" : "border: 1px solid #ddd;")">
                            <MudRadio Value="@("custom")" Color="Color.Secondary">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle1"><b>⚙️ Custom (Advanced)</b></MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Fine-tune all detection parameters manually
                                    </MudText>
                                </MudStack>
                            </MudRadio>
                        </MudPaper>
                    </MudRadioGroup>
                </MudItem>

                <!-- Advanced Settings (only shown for Custom preset) -->
                @if (_sensitivityPreset == "custom")
                {
                    <MudItem xs="12">
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2" Class="mb-3" Color="Color.Secondary">
                            <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" /> Advanced Detection Settings
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudSlider T="uint"
                                       @bind-Value="_changeLimit"
                                       Min="1"
                                       Max="100"
                                       Step="1"
                                       Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       Style="flex: 1;">
                                Sensitivity: @_changeLimit%
                            </MudSlider>
                            <HelpTooltip Title="Motion Sensitivity"
                                         Content="Percentage of pixels that must change to trigger motion detection. Lower values = more sensitive."
                                         Recommendation="10-20% for most cameras" />
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudSlider T="uint"
                                       @bind-Value="_noiseThreshold"
                                       Min="0"
                                       Max="255"
                                       Step="5"
                                       Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       Style="flex: 1;">
                                Noise Threshold: @_noiseThreshold
                            </MudSlider>
                            <HelpTooltip Title="Noise Threshold"
                                         Content="Filters out random pixel changes caused by camera sensor noise. Higher values make the detector less sensitive to tiny changes."
                                         Recommendation="30-80 for most cameras, higher for noisy sensors" />
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudNumericField T="uint"
                                             @bind-Value="_detectorDelay"
                                             Label="Detector Delay (ms)"
                                             Variant="Variant.Outlined"
                                             Min="100"
                                             Step="100"
                                             HideSpinButtons="false"
                                             Style="flex: 1;" />
                            <HelpTooltip Title="Detector Delay"
                                         Content="Time delay between motion detection checks in milliseconds. Lower values = faster detection but more CPU usage."
                                         Recommendation="500-2000ms for balanced performance" />
                        </MudStack>
                    </MudItem>
                }
                else
                {
                    <!-- Show current preset values as readonly info -->
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                            <MudText Typo="Typo.body2">
                                <b>Current Settings:</b> Sensitivity: @_changeLimit% • Noise Threshold: @_noiseThreshold • Delay: @_detectorDelay ms
                            </MudText>
                        </MudAlert>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Notification Settings</b></MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="NotificationTransport"
                               @bind-Value="_newDetector.Notifications[0].Transport"
                               Label="Transport"
                               Variant="Variant.Outlined"
                               Dense="true">
                        @foreach (var transport in Enum.GetValues<NotificationTransport>())
                        {
                            <MudSelectItem Value="@transport">@transport</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="MessageType"
                               @bind-Value="_newDetector.Notifications[0].MessageType"
                               Label="Message Type"
                               Variant="Variant.Outlined"
                               Dense="true">
                        @foreach (var msgType in Enum.GetValues<MessageType>())
                        {
                            <MudSelectItem Value="@msgType">@msgType</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="_newDetector.Notifications[0].Destination"
                                      Label="Destination"
                                      Variant="Variant.Outlined"
                                      HelperText="Email, phone number, or Telegram chat ID"
                                      Style="flex: 1;" />
                        <HelpTooltip Title="Notification Destination"
                                     Content="Where to send motion alerts. For Telegram, use your chat ID (get it from @@userinfobot). For email, use your email address."
                                     Recommendation="Set up Telegram for instant notifications" />
                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_newDetector.Notifications[0].Message"
                                  Label="Message"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudCheckBox @bind-Value="_newDetector.Notifications[0].SaveNotificationContent"
                                     Label="Save Notification Content"
                                     Color="Color.Primary" />
                        <HelpTooltip Title="Save Content"
                                     Content="When enabled, saves motion detection images/videos to disk in addition to sending notifications."
                                     Recommendation="Enable to keep a record of all motion events" />
                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudNumericField T="uint"
                                         @bind-Value="_newDetector.Notifications[0].VideoLengthSec"
                                         Label="Video Length (seconds)"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="300"
                                         HideSpinButtons="false"
                                         Style="flex: 1;" />
                        <HelpTooltip Title="Video Length"
                                     Content="Duration of video clip to record and send when motion is detected. Longer videos use more storage and bandwidth."
                                     Recommendation="10-30 seconds is usually sufficient" />
                    </MudStack>
                </MudItem>

                @if (_validationErrors.Count > 0)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" ShowCloseIcon="true" CloseIconClicked="@(() => _validationErrors.Clear())">
                            <MudText Typo="Typo.body2"><b>Validation Errors:</b></MudText>
                            @foreach (var error in _validationErrors)
                            {
                                <MudText Typo="Typo.body2">• @error</MudText>
                            }
                        </MudAlert>
                    </MudItem>
                }

                @if (_successMessage != null)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="@(() => _successMessage = null)">
                            @_successMessage
                        </MudAlert>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudStack Row="true" Spacing="2">
                        <MudButton OnClick="@AddDetectorClicked"
                                   Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Disabled="@(_selectedCameraId == -1 || _isStarting)">
                            @if (_isStarting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ml-2">Starting...</MudText>
                            }
                            else
                            {
                                <text>Start Detector</text>
                            }
                        </MudButton>

                        <MudButton OnClick="@ResetDetectorForm"
                                   Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Clear">
                            Clear
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudStack>
</MudPaper>

@code {
    private MotionDetectionCameraSettingDto _newDetector = new();
    private int _selectedCameraId = -1;
    private bool _isLoading = false;
    private bool _isStarting = false;
    private bool _showDetectorStream = false;
    private string? _errorMessage;
    private string? _successMessage;
    private List<string> _validationErrors = new();
    private uint _changeLimit = 10;
    private uint _noiseThreshold = 50;
    private uint _detectorDelay = 1000;
    private string _sensitivityPreset = "medium"; // Default to medium sensitivity

    protected override async Task OnInitializedAsync()
    {
        _authenticationService.OnLogIn += OnLogin;
        _authenticationService.OnLogOut += OnLogout;

        ResetDetectorForm();

        if (_currentUserState.Cameras == null)
            _currentUserState.Cameras = await GetCamerasAsync();

        if (_currentUserState.Detectors == null)
            await LoadDetectors();
    }

    private void ResetDetectorForm()
    {
        _newDetector = new MotionDetectionCameraSettingDto()
        {
            FrameFormat = new FrameFormatDto(),
            MotionDetectParameters = new MotionDetectorParametersDto
            {
                NoiseThreshold = 50,
                ChangeLimit = 10,
                DetectorDelayMs = 1000
            },
            User = _authenticationService?.UserInfo?.Login ?? string.Empty,
            Notifications = new List<NotificationParametersDto>
            {
                new NotificationParametersDto
                {
                    VideoLengthSec = 15,
                    Transport = NotificationTransport.Telegram,
                    MessageType = MessageType.Text
                }
            }
        };
        _selectedCameraId = -1;
        _sensitivityPreset = "medium";
        ApplyPreset("medium");
        _validationErrors.Clear();
    }

    /// <summary>
    /// Apply sensitivity preset values
    /// </summary>
    private void ApplyPreset(string preset)
    {
        switch (preset)
        {
            case "low":
                _changeLimit = 5;
                _noiseThreshold = 50;
                _detectorDelay = 2000;
                break;
            case "medium":
                _changeLimit = 10;
                _noiseThreshold = 50;
                _detectorDelay = 1000;
                break;
            case "high":
                _changeLimit = 20;
                _noiseThreshold = 50;
                _detectorDelay = 500;
                break;
            case "custom":
                // Don't change values - user will set them manually
                break;
        }

        StateHasChanged();
    }

    // Watch for preset changes
    private string SensitivityPreset
    {
        get => _sensitivityPreset;
        set
        {
            if (_sensitivityPreset != value)
            {
                _sensitivityPreset = value;
                if (value != "custom")
                {
                    ApplyPreset(value);
                }
            }
        }
    }

    private async Task LoadDetectors()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            _currentUserState.Detectors = await _http.GetFromJsonAsync<List<MotionDetectionCameraTask>>("/MotionDetector/GetDetectorTasksList");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading detectors");
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task<List<CameraDto>?> GetCamerasAsync()
    {
        try
        {
            return await _http.GetFromJsonAsync<List<CameraDto>>("/Camera/GetCameraList");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error fetching cameras");
            return null;
        }
    }

    private void ClickedCameraRow(DataGridRowClickEventArgs<MotionDetectionCameraTask> args)
    {
        _currentUserState.SelectedDetector = args.Item;
        StateHasChanged();
    }

    private void ViewDetector(MotionDetectionCameraTask detector)
    {
        _currentUserState.SelectedDetector = detector;
        _showDetectorStream = true;
        StateHasChanged();
    }

    private string GetDetectorStreamUrl()
    {
        return $"/MotionDetector/GetMotionDetectorStream?taskId={_currentUserState.SelectedDetector?.Id ?? Guid.Empty}";
    }

    private async Task ClickedRefresh()
    {
        await LoadDetectors();
    }

    private async Task ClickedStop(MotionDetectionCameraTask task)
    {
        var cameraName = _currentUserState.Cameras?.FirstOrDefault(n => n.Path == task.CameraId)?.Name ?? "Unknown";

        var confirmed = await DialogService.ShowMessageBox(
            "Stop Motion Detector?",
            $"Are you sure you want to stop motion detection on '{cameraName}'? " +
            "Notifications will no longer be sent.",
            yesText: "Stop Detector",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        try
        {
            var response = await _http.GetAsync($"/MotionDetector/StopDetector?taskId={task.Id}");
            if (response.IsSuccessStatusCode)
            {
                _successMessage = $"Motion detector stopped successfully.";
                if (_currentUserState.SelectedDetector?.Id == task.Id)
                {
                    _currentUserState.SelectedDetector = null;
                    _showDetectorStream = false;
                }
                await LoadDetectors();
            }
            else
            {
                _errorMessage = $"Failed to stop detector: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error stopping detector");
            _errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task AddDetectorClicked()
    {
        _validationErrors.Clear();
        _errorMessage = null;
        _successMessage = null;

        // Validation
        if (_selectedCameraId == -1)
        {
            _validationErrors.Add("Please select a camera");
            return;
        }

        var selectedCamera = _currentUserState.Cameras?.FirstOrDefault(c => c.Id == _selectedCameraId);
        if (selectedCamera == null)
        {
            _validationErrors.Add("Selected camera not found");
            return;
        }

        if (string.IsNullOrWhiteSpace(_newDetector.Notifications[0].Destination))
        {
            _validationErrors.Add("Notification destination is required");
            return;
        }

        _isStarting = true;
        StateHasChanged();

        try
        {
            // Set the CameraId from the selected camera's path
            _newDetector.CameraId = selectedCamera.Path;

            var width = _newDetector.FrameFormat?.Width ?? 0;
            var height = _newDetector.FrameFormat?.Height ?? 0;
            var format = _newDetector.FrameFormat?.Format ?? "";

            var response = await _http.GetAsync(
                $"/MotionDetector/StartDetector?cameraId={_selectedCameraId}" +
                $"&xResolution={width}" +
                $"&yResolution={height}" +
                $"&format={format}" +
                $"&changeLimit={_changeLimit}" +
                $"&noiseThreshold={_noiseThreshold}" +
                $"&detectorDelayMs={_detectorDelay}" +
                $"&transport={_newDetector.Notifications[0].Transport}" +
                $"&destination={Uri.EscapeDataString(_newDetector.Notifications[0].Destination)}" +
                $"&messageType={_newDetector.Notifications[0].MessageType}" +
                $"&message={Uri.EscapeDataString(_newDetector.Notifications[0].Message ?? "")}" +
                $"&saveNotificationContent={_newDetector.Notifications[0].SaveNotificationContent}" +
                $"&videoLengthSec={_newDetector.Notifications[0].VideoLengthSec}");

            if (response.IsSuccessStatusCode)
            {
                _successMessage = $"Motion detector started successfully on camera '{selectedCamera.Name}'";
                ResetDetectorForm();
                await LoadDetectors();
            }
            else
            {
                _errorMessage = $"Failed to start detector: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error starting detector");
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isStarting = false;
            StateHasChanged();
        }
    }

    private Func<MotionDetectionCameraTask, int, string> DetectorRowStyleFunc => (detector, _) =>
    {
        return _currentUserState.SelectedDetector?.Id == detector.Id
            ? "background-color: var(--mud-palette-primary-lighten); cursor: pointer;"
            : "cursor: pointer;";
    };

    private async void OnLogin(UserInfoModel? userInfo)
    {
        try
        {
            _currentUserState.Cameras = await GetCamerasAsync();
            await LoadDetectors();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during login refresh");
        }
    }

    private void OnLogout()
    {
        _currentUserState.Detectors = null;
        _currentUserState.SelectedDetector = null;
        _showDetectorStream = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        _authenticationService.OnLogIn -= OnLogin;
        _authenticationService.OnLogOut -= OnLogout;
    }
}
