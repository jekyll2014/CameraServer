    private void OpenAddCameraDialog()
    {
        _editingCamera = new CameraConfigDto 
        { 
            AllowedRoles = new List<string>(),
            Type = "IP",
            AuthenticationType = "Plain"
        };
        _cameraRoleAdmin = false;
        _cameraRoleUser = false;
        _cameraRoleGuest = false;
        StateHasChanged();
    }

    private void OpenEditCameraDialog(CameraConfigDto camera)
    {
        _editingCamera = new CameraConfigDto
        {
            Type = camera.Type,
            Name = camera.Name,
            Path = camera.Path,
            AllowedRoles = new List<string>(camera.AllowedRoles ?? new List<string>()),
            AuthenticationType = camera.AuthenticationType,
            Login = camera.Login,
            Password = camera.Password
        };
        _cameraRoleAdmin = _editingCamera.AllowedRoles.Contains("Admin");
        _cameraRoleUser = _editingCamera.AllowedRoles.Contains("User");
        _cameraRoleGuest = _editingCamera.AllowedRoles.Contains("Guest");
        StateHasChanged();
    }

    private void CancelEditCamera()
    {
        _editingCamera = null;
        StateHasChanged();
    }

    private async Task SaveCamera(CameraConfigDto camera)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(camera.Name))
            {
                _camerasErrorMessage = "Camera name is required";
                return;
            }

            if (string.IsNullOrWhiteSpace(camera.Path))
            {
                _camerasErrorMessage = "Camera path is required";
                return;
            }

            // Update roles from checkboxes
            camera.AllowedRoles = new List<string>();
            if (_cameraRoleAdmin) camera.AllowedRoles.Add("Admin");
            if (_cameraRoleUser) camera.AllowedRoles.Add("User");
            if (_cameraRoleGuest) camera.AllowedRoles.Add("Guest");

            if (camera.AllowedRoles.Count == 0)
            {
                _camerasErrorMessage = "At least one role must be selected";
                return;
            }

            // Check if this is a new camera or existing
            var existingCamera = _cameraSettings.CustomCameras.FirstOrDefault(c => c.Path == camera.Path);
            if (existingCamera != null && existingCamera.Name != camera.Name)
            {
                _cameraSettings.CustomCameras.Remove(existingCamera);
            }
            else if (!_cameraSettings.CustomCameras.Contains(camera) && existingCamera == null)
            {
                _cameraSettings.CustomCameras.Add(camera);
            }

            // Update entire camera settings via dedicated endpoint
            var response = await _http.PostAsJsonAsync("/Configuration/UpdateCameraSettings", _cameraSettings);
            if (response.IsSuccessStatusCode)
            {
                _camerasSuccessMessage = "Camera saved successfully!";
                _editingCamera = null;
                _camerasErrorMessage = null;
                await RefreshCameras();
            }
            else
            {
                var errorResponse = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();
                _camerasErrorMessage = errorResponse?.ErrorMessage ?? $"Failed to save camera: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving camera");
            _camerasErrorMessage = $"Error: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task DeleteCamera(CameraConfigDto camera)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Confirm Delete",
            $"Are you sure you want to delete camera '{camera.Name}'?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                _cameraSettings.CustomCameras.Remove(camera);
                
                // Update via dedicated endpoint
                var response = await _http.PostAsJsonAsync("/Configuration/UpdateCameraSettings", _cameraSettings);
                if (response.IsSuccessStatusCode)
                {
                    _camerasSuccessMessage = "Camera deleted successfully!";
                    _camerasErrorMessage = null;
                    await RefreshCameras();
                }
                else
                {
                    var errorResponse = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();
                    _camerasErrorMessage = errorResponse?.ErrorMessage ?? $"Failed to delete camera: {response.StatusCode}";
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting camera");
                _camerasErrorMessage = $"Error: {ex.Message}";
            }
        }
    }

    #endregion

    #region User Management

    private async Task RefreshUsers()
    {
        _isUsersLoading = true;
        _usersErrorMessage = null;
        StateHasChanged();

        try
        {
            var response = await _http.GetAsync("/Configuration/GetUsers");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<List<UserManagementDto>>>();
                if (apiResponse?.Success ?? false)
                {
                    _users = apiResponse.Data ?? new List<UserManagementDto>();
                }
                else
                {
                    _usersErrorMessage = apiResponse?.ErrorMessage ?? "Failed to load users";
                }
            }
            else
            {
                _usersErrorMessage = $"Server error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing users");
            _usersErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isUsersLoading = false;
            StateHasChanged();
        }
    }

    private void OpenAddUserDialog()
    {
        _editingUser = new UserManagementDto 
        { 
            Login = string.Empty,
            Roles = new List<string>(),
            TelegramId = 0,
            DefaultUser = false
        };
        _editingUserPassword = string.Empty;
        _userRoleAdmin = false;
        _userRoleUser = false;
        _userRoleGuest = false;
        _userDefaultUser = false;
        StateHasChanged();
    }

    private void OpenEditUserDialog(UserManagementDto user)
    {
        _editingUser = new UserManagementDto
        {
            Login = user.Login,
            Name = user.Name,
            Roles = new List<string>(user.Roles ?? new List<string>()),
            TelegramId = user.TelegramId,
            TelegramName = user.TelegramName,
            DefaultCodec = user.DefaultCodec,
            DefaultUser = user.DefaultUser
        };
        _editingUserPassword = string.Empty;
        _userRoleAdmin = _editingUser.Roles.Contains("Admin");
        _userRoleUser = _editingUser.Roles.Contains("User");
        _userRoleGuest = _editingUser.Roles.Contains("Guest");
        _userDefaultUser = _editingUser.DefaultUser;
        StateHasChanged();
    }

    private void CancelEditUser()
    {
        _editingUser = null;
        _editingUserPassword = string.Empty;
        StateHasChanged();
    }

    private async Task SaveCurrentUser()
    {
        if (_editingUser == null)
            return;

        // Update roles from checkboxes
        _editingUser.Roles = new List<string>();
        if (_userRoleAdmin) _editingUser.Roles.Add("Admin");
        if (_userRoleUser) _editingUser.Roles.Add("User");
        if (_userRoleGuest) _editingUser.Roles.Add("Guest");

        // Update DefaultUser from checkbox
        _editingUser.DefaultUser = _userDefaultUser;

        // Create a DTO for saving
        var userDto = new UserCreateUpdateDto
        {
            Login = _editingUser.Login,
            Name = _editingUser.Name,
            Password = _editingUserPassword,
            Roles = _editingUser.Roles,
            TelegramId = _editingUser.TelegramId,
            TelegramName = _editingUser.TelegramName,
            DefaultCodec = _editingUser.DefaultCodec,
            DefaultUser = _editingUser.DefaultUser
        };

        await SaveUser(userDto);
    }

    private async Task SaveUser(UserCreateUpdateDto user)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(user.Login))
            {
                _usersErrorMessage = "Login is required";
                return;
            }

            var isNewUser = !_users.Any(u => u.Login == user.Login);
            
            if (string.IsNullOrWhiteSpace(user.Password) && isNewUser)
            {
                _usersErrorMessage = "Password is required for new users";
                return;
            }

            if (user.Roles == null || user.Roles.Count == 0)
            {
                _usersErrorMessage = "At least one role must be selected";
                return;
            }

            // Use dedicated SaveUser endpoint for individual user operations
            var response = await _http.PostAsJsonAsync("/Configuration/SaveUser", user);
            if (response.IsSuccessStatusCode)
            {
                _usersSuccessMessage = "User saved successfully!";
                _editingUser = null;
                _editingUserPassword = string.Empty;
                _usersErrorMessage = null;
                await RefreshUsers();
            }
            else
            {
                var errorResponse = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();
                _usersErrorMessage = errorResponse?.ErrorMessage ?? $"Failed to save user: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving user");
            _usersErrorMessage = $"Error: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task DeleteUser(UserManagementDto user)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Confirm Delete",
            $"Are you sure you want to delete user '{user.Login}'?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                // Use dedicated DeleteUser endpoint
                var response = await _http.DeleteAsync($"/Configuration/DeleteUser?login={user.Login}");
                if (response.IsSuccessStatusCode)
                {
                    _usersSuccessMessage = "User deleted successfully!";
                    _usersErrorMessage = null;
                    await RefreshUsers();
                }
                else
                {
                    var errorResponse = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();
                    _usersErrorMessage = errorResponse?.ErrorMessage ?? $"Failed to delete user: {response.StatusCode}";
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting user");
                _usersErrorMessage = $"Error: {ex.Message}";
            }
        }
    }

