@using CameraServer.Client.Services
@using CameraServer.Shared
@using CameraServer.Shared.DTO

@inject HttpClient _http
@inject IAuthenticationService _authenticationService
@inject ICurrentUserState _currentUserState
@inject IDialogService DialogService
@inject ILogger<SettingsPanel> Logger

<MudPaper Class="pa-4">
    @if (!IsAdmin())
    {
        <MudAlert Severity="Severity.Warning">
            <MudText Typo="Typo.h6">Access Denied</MudText>
            <MudText>Only administrators can access the Settings panel.</MudText>
        </MudAlert>
    }
    else
    {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
            <!-- Camera Management Tab -->
            <MudTabPanel Text="Custom Cameras" Icon="@Icons.Material.Filled.Videocam">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">Custom Camera Management</MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudButton OnClick="@RefreshCameras"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@_isCamerasLoading">
                                Refresh
                            </MudButton>
                            <MudButton OnClick="@OpenAddCameraDialog"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Disabled="@_isCamerasLoading">
                                Add Camera
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (_camerasErrorMessage != null)
                    {
                        <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="@(() => _camerasErrorMessage = null)">
                            @_camerasErrorMessage
                        </MudAlert>
                    }

                    @if (_camerasSuccessMessage != null)
                    {
                        <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="@(() => _camerasSuccessMessage = null)">
                            @_camerasSuccessMessage
                        </MudAlert>
                    }

                    @if (_isCamerasLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else if (_cameraSettings?.CustomCameras?.Count > 0)
                    {
                        <MudTable Items="@_cameraSettings.CustomCameras" Hover="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>Name</MudTh>
                                <MudTh>Type</MudTh>
                                <MudTh>Path</MudTh>
                                <MudTh>Auth Type</MudTh>
                                <MudTh>Roles</MudTh>
                                <MudTh>Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Name">@context.Name</MudTd>
                                <MudTd DataLabel="Type">@context.Type</MudTd>
                                <MudTd DataLabel="Path" Class="mud-table-cell-small">@context.Path</MudTd>
                                <MudTd DataLabel="Auth Type">@context.AuthenticationType</MudTd>
                                <MudTd DataLabel="Roles">@string.Join(", ", context.AllowedRoles ?? new List<string>())</MudTd>
                                <MudTd DataLabel="Actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@((e) => OpenEditCameraDialog(context))" Size="Size.Small" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@((e) => DeleteCamera(context))" Size="Size.Small" Color="Color.Error" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">
                            No custom cameras configured. Click "Add Camera" to add one.
                        </MudAlert>
                    }

                    <MudAlert Severity="Severity.Warning" Class="mt-4">
                        <MudText Typo="Typo.body2">
                            <b>Note:</b> Camera configuration changes require a server restart to take effect.
                            Use the System Settings tab to restart the server after making changes.
                        </MudText>
                    </MudAlert>

                    <!-- Add/Edit Camera Dialog -->
                    @if (_editingCamera != null)
                    {
                        <MudPaper Elevation="2" Class="pa-4 mt-4">
                            <MudText Typo="Typo.h6" Class="mb-3">@(_editingCamera == null || string.IsNullOrEmpty(_editingCamera.Path) ? "Add New Camera" : "Edit Camera")</MudText>
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_editingCamera.Name"
                                                  Label="Camera Name"
                                                  Variant="Variant.Outlined"
                                                  Placeholder="e.g., Front Door Camera" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudSelect @bind-Value="_editingCamera.Type"
                                              Label="Camera Type"
                                              Variant="Variant.Outlined">
                                        <MudSelectItem Value="string.Empty">-- Select Type --</MudSelectItem>
                                        <MudSelectItem Value="@("IP")">IP (RTSP)</MudSelectItem>
                                        <MudSelectItem Value="@("MJPEG")">MJPEG</MudSelectItem>
                                        <MudSelectItem Value="@("USB")">USB</MudSelectItem>
                                        <MudSelectItem Value="@("USB_FC")">USB Flasncap</MudSelectItem>
                                    </MudSelect>
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudSelect @bind-Value="_editingCamera.AuthenticationType"
                                              Label="Authentication Type"
                                              Variant="Variant.Outlined">
                                        <MudSelectItem Value="@("None")">None</MudSelectItem>
                                        <MudSelectItem Value="@("Plain")">Plain</MudSelectItem>
                                        <MudSelectItem Value="@("Basic")">Basic</MudSelectItem>
                                    </MudSelect>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_editingCamera.Path"
                                                  Label="Camera Path/URL"
                                                  Variant="Variant.Outlined"
                                                  Lines="3"
                                                  Placeholder="e.g., rtsp://admin:password@192.168.1.100:554/stream" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_editingCamera.Login"
                                                  Label="Login (if needed)"
                                                  Variant="Variant.Outlined" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_editingCamera.Password"
                                                  Label="Password (if needed)"
                                                  Variant="Variant.Outlined"
                                                  InputType="InputType.Password" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudText Typo="Typo.subtitle2">Allowed Roles</MudText>
                                    <MudStack Row="true" Spacing="2">
                                        <MudCheckBox T="bool" @bind-Checked="_cameraRoleAdmin" Label="Admin" />
                                        <MudCheckBox T="bool" @bind-Checked="_cameraRoleUser" Label="User" />
                                        <MudCheckBox T="bool" @bind-Checked="_cameraRoleGuest" Label="Guest" />
                                    </MudStack>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Default"
                                                   OnClick="@CancelEditCamera">
                                            Cancel
                                        </MudButton>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Success"
                                                   OnClick="@(() => SaveCamera(_editingCamera))">
                                            Save Camera
                                        </MudButton>
                                    </MudStack>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudStack>
            </MudTabPanel>

            <!-- User Management Tab -->
            <MudTabPanel Text="User Management" Icon="@Icons.Material.Filled.People">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">User Management</MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudButton OnClick="@RefreshUsers"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@_isUsersLoading">
                                Refresh
                            </MudButton>
                            <MudButton OnClick="@OpenAddUserDialog"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Disabled="@_isUsersLoading">
                                Add User
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (_usersErrorMessage != null)
                    {
                        <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="@(() => _usersErrorMessage = null)">
                            @_usersErrorMessage
                        </MudAlert>
                    }

                    @if (_usersSuccessMessage != null)
                    {
                        <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="@(() => _usersSuccessMessage = null)">
                            @_usersSuccessMessage
                        </MudAlert>
                    }

                    @if (_isUsersLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else if (_users?.Count > 0)
                    {
                        <MudTable Items="@_users" Hover="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>Login</MudTh>
                                <MudTh>Name</MudTh>
                                <MudTh>Roles</MudTh>
                                <MudTh>Telegram ID</MudTh>
                                <MudTh>Codec</MudTh>
                                <MudTh>Default User</MudTh>
                                <MudTh>Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Login">@context.Login</MudTd>
                                <MudTd DataLabel="Name">@context.Name</MudTd>
                                <MudTd DataLabel="Roles">@string.Join(", ", context.Roles ?? new List<string>())</MudTd>
                                <MudTd DataLabel="Telegram ID">@context.TelegramId</MudTd>
                                <MudTd DataLabel="Codec">@context.DefaultCodec</MudTd>
                                <MudTd DataLabel="Default User">
                                    @if (context.DefaultUser)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">
                                            Default
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="Color.Default" />
                                    }
                                </MudTd>
                                <MudTd DataLabel="Actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@((e) => OpenEditUserDialog(context))" Size="Size.Small" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@((e) => DeleteUser(context))" Size="Size.Small" Color="Color.Error" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">
                            No users configured. Click "Add User" to add one.
                        </MudAlert>
                    }

                    <MudAlert Severity="Severity.Warning" Class="mt-4">
                        <MudText Typo="Typo.body2">
                            <b>Note:</b> User configuration changes require a server restart to take effect.
                            Use the System Settings tab to restart the server after making changes.
                        </MudText>
                    </MudAlert>

                    <!-- Add/Edit User Dialog -->
                    @if (_editingUser != null)
                    {
                        <MudPaper Elevation="2" Class="pa-4 mt-4">
                            <MudText Typo="Typo.h6" Class="mb-3">@(string.IsNullOrEmpty(_editingUser.Login) ? "Add New User" : "Edit User")</MudText>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_editingUser.Login"
                                                  Label="Login"
                                                  Variant="Variant.Outlined"
                                                  Disabled="@(!string.IsNullOrEmpty(_editingUser.Login))"
                                                  Placeholder="Username" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_editingUser.Name"
                                                  Label="Display Name"
                                                  Variant="Variant.Outlined"
                                                  Placeholder="Full name" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_editingUserPassword"
                                                  Label="Password"
                                                  Variant="Variant.Outlined"
                                                  InputType="InputType.Password"
                                                  Placeholder="Leave empty to keep unchanged" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_editingUser.TelegramId"
                                                     Label="Telegram ID"
                                                     Variant="Variant.Outlined" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_editingUser.DefaultCodec"
                                                  Label="Default Codec"
                                                  Variant="Variant.Outlined"
                                                  Placeholder="e.g., MP4V, AVC" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudText Typo="Typo.subtitle2">Roles</MudText>
                                    <MudStack Row="true" Spacing="2">
                                        <MudCheckBox T="bool" @bind-Checked="_userRoleAdmin" Label="Admin" />
                                        <MudCheckBox T="bool" @bind-Checked="_userRoleUser" Label="User" />
                                        <MudCheckBox T="bool" @bind-Checked="_userRoleGuest" Label="Guest" />
                                    </MudStack>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudDivider Class="my-2" />
                                    <MudCheckBox T="bool" @bind-Checked="_userDefaultUser"
                                                 Color="Color.Success">
                                        <MudText Typo="Typo.body2">
                                            <b>Mark as Default User</b>
                                        </MudText>
                                    </MudCheckBox>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-8">
                                        Only one user can be marked as default. This user will be automatically used for:
                                        <ul>
                                            <li>Unknown username login attempts</li>
                                            <li>Telegram users without a registered Telegram ID</li>
                                        </ul>
                                    </MudText>
                                    @if (_userDefaultUser && _users.Any(u => u.DefaultUser && u.Login != _editingUser?.Login))
                                    {
                                        var currentDefault = _users.First(u => u.DefaultUser && u.Login != _editingUser?.Login);
                                        <MudAlert Severity="Severity.Warning" Class="mt-2" Dense="true">
                                            <b>Warning:</b> User '<b>@currentDefault.Login</b>' is currently set as the default user. 
                                            Saving this will replace it.
                                        </MudAlert>
                                    }
                                </MudItem>

                                <MudItem xs="12">
                                    <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Default"
                                                   OnClick="@CancelEditUser">
                                            Cancel
                                        </MudButton>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Success"
                                                   OnClick="@SaveCurrentUser">
                                            Save User
                                        </MudButton>
                                    </MudStack>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudStack>
            </MudTabPanel>

            <!-- Telegram Settings Tab -->
            <MudTabPanel Text="Telegram" Icon="@Icons.Material.Filled.ChatBubble">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">Telegram Configuration</MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudButton OnClick="@RefreshTelegramSettings"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@_isRuntimeLoading">
                                Refresh
                            </MudButton>
                            <MudButton OnClick="@SaveTelegramSettings"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Disabled="@_isRuntimeLoading">
                                Save
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (_runtimeErrorMessage != null)
                    {
                        <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="@(() => _runtimeErrorMessage = null)">
                            @_runtimeErrorMessage
                        </MudAlert>
                    }

                    @if (_runtimeSuccessMessage != null)
                    {
                        <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="@(() => _runtimeSuccessMessage = null)">
                            @_runtimeSuccessMessage
                        </MudAlert>
                    }

                    @if (_isRuntimeLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else
                    {
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Telegram Bot Settings</MudText>
                            <MudAlert Severity="Severity.Info" Class="mb-3">
                                Changes are applied immediately without server restart.
                            </MudAlert>
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_runtimeSettings.TelegramSettings.Token"
                                                  Label="Bot Token"
                                                  Variant="Variant.Outlined"
                                                  HelperText="Your Telegram bot token"
                                                  Disabled="@_isRuntimeLoading" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.TelegramSettings.ReconnectTimeout"
                                                     Label="Reconnect Timeout (seconds)"
                                                     Variant="Variant.Outlined"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.TelegramSettings.DefaultVideoTime"
                                                     Label="Default Video Time (seconds)"
                                                     Variant="Variant.Outlined"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="uint" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.TelegramSettings.DefaultVideoQuality"
                                                     Label="Default Video Quality (1-100)"
                                                     Variant="Variant.Outlined"
                                                     Min="1" Max="100"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="byte" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.TelegramSettings.DefaultImageQuality"
                                                     Label="Default Image Quality (1-100)"
                                                     Variant="Variant.Outlined"
                                                     Min="1" Max="100"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="byte" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudStack>
            </MudTabPanel>

            <!-- Brute Force Detection Tab -->
            <MudTabPanel Text="Security" Icon="@Icons.Material.Filled.Security">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">Brute Force Detection</MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudButton OnClick="@RefreshBruteForceSettings"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@_isRuntimeLoading">
                                Refresh
                            </MudButton>
                            <MudButton OnClick="@SaveBruteForceSettings"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Disabled="@_isRuntimeLoading">
                                Save
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (_runtimeErrorMessage != null)
                    {
                        <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="@(() => _runtimeErrorMessage = null)">
                            @_runtimeErrorMessage
                        </MudAlert>
                    }

                    @if (_runtimeSuccessMessage != null)
                    {
                        <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="@(() => _runtimeSuccessMessage = null)">
                            @_runtimeSuccessMessage
                        </MudAlert>
                    }

                    @if (_isRuntimeLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else
                    {
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Brute Force Detection Settings</MudText>
                            <MudAlert Severity="Severity.Info" Class="mb-3">
                                Changes are applied immediately without server restart.
                            </MudAlert>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.BruteForceDetectionSettings.RetriesPerMinute"
                                                     Label="Retries Per Minute"
                                                     Variant="Variant.Outlined"
                                                     HelperText="Max login attempts per minute"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.BruteForceDetectionSettings.RetriesPerHour"
                                                     Label="Retries Per Hour"
                                                     Variant="Variant.Outlined"
                                                     HelperText="Max login attempts per hour"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudStack>
            </MudTabPanel>

            <!-- Motion Detection Settings Tab -->
            <MudTabPanel Text="Motion Detection" Icon="@Icons.Material.Filled.VideoCameraFront">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">Motion Detection Configuration</MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudButton OnClick="@RefreshMotionDetectionSettings"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@_isRuntimeLoading">
                                Refresh
                            </MudButton>
                            <MudButton OnClick="@SaveMotionDetectionSettings"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Disabled="@_isRuntimeLoading">
                                Save
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (_runtimeErrorMessage != null)
                    {
                        <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="@(() => _runtimeErrorMessage = null)">
                            @_runtimeErrorMessage
                        </MudAlert>
                    }

                    @if (_runtimeSuccessMessage != null)
                    {
                        <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="@(() => _runtimeSuccessMessage = null)">
                            @_runtimeSuccessMessage
                        </MudAlert>
                    }

                    @if (_isRuntimeLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else
                    {
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Storage Path</MudText>
                            <MudAlert Severity="Severity.Info" Class="mb-3">
                                Changes are applied immediately without server restart.
                            </MudAlert>
                            <MudTextField @bind-Value="_runtimeSettings.MotionDetectionSettings.StoragePath"
                                          Label="Storage Path"
                                          Variant="Variant.Outlined"
                                          HelperText="Directory for motion detection recordings"
                                          Disabled="@_isRuntimeLoading"
                                          Class="mb-4" />

                            <MudText Typo="Typo.h6" Class="mb-3 mt-6">Detection Parameters</MudText>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.MotionDetectionSettings.DefaultMotionDetectParameters.Width"
                                                     Label="Detection Width (pixels)"
                                                     Variant="Variant.Outlined"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.MotionDetectionSettings.DefaultMotionDetectParameters.Height"
                                                     Label="Detection Height (pixels)"
                                                     Variant="Variant.Outlined"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.MotionDetectionSettings.DefaultMotionDetectParameters.DetectorDelayMs"
                                                     Label="Detector Delay (ms)"
                                                     Variant="Variant.Outlined"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="uint" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.MotionDetectionSettings.DefaultMotionDetectParameters.NoiseThreshold"
                                                     Label="Noise Threshold (0-255)"
                                                     Variant="Variant.Outlined"
                                                     Min="0" Max="255"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="byte" />
                                </MudItem>

