@using System.Net.Http.Json
@using CameraServer.Client.Services
@using CameraServer.Shared
@using CameraServer.Shared.DTO

@inject HttpClient _http
@inject IAuthenticationService _authenticationService
@inject ICurrentUserState _currentUserState
@inject IDialogService DialogService
@inject ILogger<SettingsPanel> Logger

<MudPaper Class="pa-4">
    @if (!IsAdmin())
    {
        <MudAlert Severity="Severity.Warning">
            <MudText Typo="Typo.h6">Access Denied</MudText>
            <MudText>Only administrators can access the Settings panel.</MudText>
        </MudAlert>
    }
    else
    {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
            <!-- Camera Management Tab -->
            <MudTabPanel Text="Camera Management" Icon="@Icons.Material.Filled.Videocam">
                <MudText Typo="Typo.h5" Class="mb-4">Camera Configuration</MudText>
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    <b>Note:</b> Camera configuration changes require server restart to take effect.
                    Use the System Settings tab to restart the server after making changes.
                </MudAlert>
                <MudText Typo="Typo.body1">
                    Camera configuration is currently managed through appsettings.json file.
                    Please edit the file manually and restart the server to apply changes.
                </MudText>
            </MudTabPanel>

            <!-- User Management Tab -->
            <MudTabPanel Text="User Management" Icon="@Icons.Material.Filled.People">
                <MudText Typo="Typo.h5" Class="mb-4">User Management</MudText>
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    <b>Note:</b> User management changes require server restart to take effect.
                    Use the System Settings tab to restart the server after making changes.
                </MudAlert>
                <MudText Typo="Typo.body1">
                    User configuration is currently managed through appsettings.json file.
                    Please edit the file manually and restart the server to apply changes.
                </MudText>
            </MudTabPanel>

            <!-- Telegram Settings Tab -->
            <MudTabPanel Text="Telegram" Icon="@Icons.Material.Filled.ChatBubble">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">Telegram Configuration</MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudButton OnClick="@RefreshRuntimeSettings"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@_isRuntimeLoading">
                                Refresh
                            </MudButton>
                            <MudButton OnClick="@SaveRuntimeSettings"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Disabled="@_isRuntimeLoading">
                                Save
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (_runtimeErrorMessage != null)
                    {
                        <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="@(() => _runtimeErrorMessage = null)">
                            @_runtimeErrorMessage
                        </MudAlert>
                    }

                    @if (_runtimeSuccessMessage != null)
                    {
                        <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="@(() => _runtimeSuccessMessage = null)">
                            @_runtimeSuccessMessage
                        </MudAlert>
                    }

                    @if (_isRuntimeLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else
                    {
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Telegram Bot Settings</MudText>
                            <MudAlert Severity="Severity.Info" Class="mb-3">
                                Changes are applied immediately without server restart.
                            </MudAlert>
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_runtimeSettings.TelegramSettings.Token"
                                                  Label="Bot Token"
                                                  Variant="Variant.Outlined"
                                                  HelperText="Your Telegram bot token"
                                                  Disabled="@_isRuntimeLoading" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.TelegramSettings.ReconnectTimeout"
                                                     Label="Reconnect Timeout (seconds)"
                                                     Variant="Variant.Outlined"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.TelegramSettings.DefaultVideoTime"
                                                     Label="Default Video Time (seconds)"
                                                     Variant="Variant.Outlined"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="uint" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.TelegramSettings.DefaultVideoQuality"
                                                     Label="Default Video Quality (1-100)"
                                                     Variant="Variant.Outlined"
                                                     Min="1" Max="100"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="byte" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.TelegramSettings.DefaultImageQuality"
                                                     Label="Default Image Quality (1-100)"
                                                     Variant="Variant.Outlined"
                                                     Min="1" Max="100"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="byte" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudStack>
            </MudTabPanel>

            <!-- Brute Force Detection Tab -->
            <MudTabPanel Text="Security" Icon="@Icons.Material.Filled.Security">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">Brute Force Detection</MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudButton OnClick="@RefreshRuntimeSettings"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@_isRuntimeLoading">
                                Refresh
                            </MudButton>
                            <MudButton OnClick="@SaveRuntimeSettings"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Disabled="@_isRuntimeLoading">
                                Save
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (_runtimeErrorMessage != null)
                    {
                        <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="@(() => _runtimeErrorMessage = null)">
                            @_runtimeErrorMessage
                        </MudAlert>
                    }

                    @if (_runtimeSuccessMessage != null)
                    {
                        <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="@(() => _runtimeSuccessMessage = null)">
                            @_runtimeSuccessMessage
                        </MudAlert>
                    }

                    @if (_isRuntimeLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else
                    {
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Brute Force Detection Settings</MudText>
                            <MudAlert Severity="Severity.Info" Class="mb-3">
                                Changes are applied immediately without server restart.
                            </MudAlert>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.BruteForceDetectionSettings.RetriesPerMinute"
                                                     Label="Retries Per Minute"
                                                     Variant="Variant.Outlined"
                                                     HelperText="Max login attempts per minute"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.BruteForceDetectionSettings.RetriesPerHour"
                                                     Label="Retries Per Hour"
                                                     Variant="Variant.Outlined"
                                                     HelperText="Max login attempts per hour"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudStack>
            </MudTabPanel>

            <!-- Motion Detection Settings Tab -->
            <MudTabPanel Text="Motion Detection" Icon="@Icons.Material.Filled.VideoCameraFront">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">Motion Detection Configuration</MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudButton OnClick="@RefreshRuntimeSettings"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@_isRuntimeLoading">
                                Refresh
                            </MudButton>
                            <MudButton OnClick="@SaveRuntimeSettings"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Disabled="@_isRuntimeLoading">
                                Save
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (_runtimeErrorMessage != null)
                    {
                        <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="@(() => _runtimeErrorMessage = null)">
                            @_runtimeErrorMessage
                        </MudAlert>
                    }

                    @if (_runtimeSuccessMessage != null)
                    {
                        <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="@(() => _runtimeSuccessMessage = null)">
                            @_runtimeSuccessMessage
                        </MudAlert>
                    }

                    @if (_isRuntimeLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else
                    {
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Storage Path</MudText>
                            <MudAlert Severity="Severity.Info" Class="mb-3">
                                Changes are applied immediately without server restart.
                            </MudAlert>
                            <MudTextField @bind-Value="_runtimeSettings.MotionDetectionSettings.StoragePath"
                                          Label="Storage Path"
                                          Variant="Variant.Outlined"
                                          HelperText="Directory for motion detection recordings"
                                          Disabled="@_isRuntimeLoading"
                                          Class="mb-4" />

                            <MudText Typo="Typo.h6" Class="mb-3 mt-6">Detection Parameters</MudText>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.MotionDetectionSettings.DefaultMotionDetectParameters.Width"
                                                     Label="Detection Width (pixels)"
                                                     Variant="Variant.Outlined"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.MotionDetectionSettings.DefaultMotionDetectParameters.Height"
                                                     Label="Detection Height (pixels)"
                                                     Variant="Variant.Outlined"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.MotionDetectionSettings.DefaultMotionDetectParameters.DetectorDelayMs"
                                                     Label="Detector Delay (ms)"
                                                     Variant="Variant.Outlined"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="uint" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.MotionDetectionSettings.DefaultMotionDetectParameters.NoiseThreshold"
                                                     Label="Noise Threshold (0-255)"
                                                     Variant="Variant.Outlined"
                                                     Min="0" Max="255"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="byte" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.MotionDetectionSettings.DefaultMotionDetectParameters.ChangeLimit"
                                                     Label="Change Limit (%)"
                                                     Variant="Variant.Outlined"
                                                     Min="0" Max="100"
                                                     Step="0.1"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="double" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.MotionDetectionSettings.DefaultMotionDetectParameters.KeepImageBuffer"
                                                     Label="Image Buffer Size"
                                                     Variant="Variant.Outlined"
                                                     Min="1"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="uint" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.MotionDetectionSettings.DefaultMotionDetectParameters.TextNotificationDelay"
                                                     Label="Text Notification Delay (s)"
                                                     Variant="Variant.Outlined"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="uint" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.MotionDetectionSettings.DefaultMotionDetectParameters.ImageNotificationDelay"
                                                     Label="Image Notification Delay (s)"
                                                     Variant="Variant.Outlined"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="uint" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.MotionDetectionSettings.DefaultMotionDetectParameters.VideoNotificationDelay"
                                                     Label="Video Notification Delay (s)"
                                                     Variant="Variant.Outlined"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="uint" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudStack>
            </MudTabPanel>

            <!-- Video Recording Settings Tab -->
            <MudTabPanel Text="Video Recording" Icon="@Icons.Material.Filled.Videocam">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">Video Recording Configuration</MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudButton OnClick="@RefreshRuntimeSettings"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@_isRuntimeLoading">
                                Refresh
                            </MudButton>
                            <MudButton OnClick="@SaveRuntimeSettings"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       Disabled="@_isRuntimeLoading">
                                Save
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (_runtimeErrorMessage != null)
                    {
                        <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="@(() => _runtimeErrorMessage = null)">
                            @_runtimeErrorMessage
                        </MudAlert>
                    }

                    @if (_runtimeSuccessMessage != null)
                    {
                        <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="@(() => _runtimeSuccessMessage = null)">
                            @_runtimeSuccessMessage
                        </MudAlert>
                    }

                    @if (_isRuntimeLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else
                    {
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Recording Settings</MudText>
                            <MudAlert Severity="Severity.Info" Class="mb-3">
                                Changes are applied immediately without server restart.
                            </MudAlert>
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_runtimeSettings.VideoRecordingSettings.StoragePath"
                                                  Label="Storage Path"
                                                  Variant="Variant.Outlined"
                                                  HelperText="Directory for video recordings"
                                                  Disabled="@_isRuntimeLoading" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.VideoRecordingSettings.VideoFileLengthSeconds"
                                                     Label="File Length (seconds)"
                                                     Variant="Variant.Outlined"
                                                     HelperText="Duration of each video file (10-86400)"
                                                     Min="10" Max="86400"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="uint" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudNumericField @bind-Value="_runtimeSettings.VideoRecordingSettings.DefaultVideoQuality"
                                                     Label="Default Quality (1-100)"
                                                     Variant="Variant.Outlined"
                                                     Min="1" Max="100"
                                                     Disabled="@_isRuntimeLoading"
                                                     T="byte" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudStack>
            </MudTabPanel>

            <!-- System Settings Tab -->
            <MudTabPanel Text="System Settings" Icon="@Icons.Material.Filled.Settings">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">System Configuration</MudText>
                        <MudButton OnClick="@RefreshSystemSettings"
                                   Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="@_isSystemLoading">
                            Refresh
                        </MudButton>
                    </MudStack>

                    @if (_systemErrorMessage != null)
                    {
                        <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="@(() => _systemErrorMessage = null)">
                            @_systemErrorMessage
                        </MudAlert>
                    }

                    @if (_systemSuccessMessage != null)
                    {
                        <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="@(() => _systemSuccessMessage = null)">
                            @_systemSuccessMessage
                        </MudAlert>
                    }

                    @if (_isSystemLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else
                    {
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="mb-3">Server Configuration</MudText>
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudField Label="Server URLs" Variant="Variant.Outlined">
                                        @_systemSettings.ServerUrls
                                    </MudField>
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudField Label="External Host URL" Variant="Variant.Outlined">
                                        @_systemSettings.ExternalHostUrl
                                    </MudField>
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudField Label="Cookie Expiration Time" Variant="Variant.Outlined">
                                        @_systemSettings.CookieExpireTimeMinutes minutes
                                    </MudField>
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudField Label="Basic Authentication" Variant="Variant.Outlined">
                                        <MudChip T="string" Size="Size.Small" Color="@(_systemSettings.AllowBasicAuthentication ? Color.Success : Color.Error)">
                                            @(_systemSettings.AllowBasicAuthentication ? "Enabled" : "Disabled")
                                        </MudChip>
                                    </MudField>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Application Information</MudText>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudField Label=".NET Version" Variant="Variant.Outlined">
                                        .NET 8.0
                                    </MudField>
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudField Label="Platform" Variant="Variant.Outlined">
                                        Blazor WebAssembly
                                    </MudField>
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudField Label="Current User" Variant="Variant.Outlined">
                                        @_authenticationService.UserInfo?.Login
                                    </MudField>
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudField Label="User Roles" Variant="Variant.Outlined">
                                        @string.Join(", ", _authenticationService.UserInfo?.Roles ?? Array.Empty<string>())
                                    </MudField>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Quick Actions</MudText>
                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Refresh"
                                           OnClick="@RefreshCameraList">
                                    Refresh Camera List
                                </MudButton>

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.RestartAlt"
                                           OnClick="@RestartServer">
                                    Restart Server
                                </MudButton>
                            </MudStack>
                        </MudPaper>

                        <MudAlert Severity="Severity.Warning">
                            <MudText Typo="Typo.body2">
                                <b>Important:</b> Changes to camera and user configurations in appsettings.json require a server restart.
                                Use the "Restart Server" button above or manually restart the application.
                            </MudText>
                        </MudAlert>
                    }
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    }
</MudPaper>

@code {
    private SystemSettingsDto _systemSettings = new();
    private RuntimeSettingsDto _runtimeSettings = new();
    private bool _isSystemLoading = false;
    private bool _isRuntimeLoading = false;
    private string? _systemErrorMessage;
    private string? _systemSuccessMessage;
    private string? _runtimeErrorMessage;
    private string? _runtimeSuccessMessage;

    protected override async Task OnInitializedAsync()
    {
        _authenticationService.OnLogIn += OnLogin;
        _authenticationService.OnLogOut += OnLogout;

        if (IsAdmin())
        {
            await RefreshSystemSettings();
            await RefreshRuntimeSettings();
        }
    }

    private bool IsAdmin()
    {
        return _authenticationService.UserInfo?.Roles?.Contains("Admin") ?? false;
    }

    private async Task RefreshSystemSettings()
    {
        _isSystemLoading = true;
        _systemErrorMessage = null;
        StateHasChanged();

        try
        {
            var response = await _http.GetAsync("/Configuration/GetSystemSettings");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<SystemSettingsDto>>();
                if (apiResponse?.Success ?? false)
                {
                    _systemSettings = apiResponse.Data ?? new SystemSettingsDto();
                }
                else
                {
                    _systemErrorMessage = apiResponse?.ErrorMessage ?? "Failed to load system settings";
                }
            }
            else
            {
                _systemErrorMessage = $"Server error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing system settings");
            _systemErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isSystemLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshRuntimeSettings()
    {
        _isRuntimeLoading = true;
        _runtimeErrorMessage = null;
        StateHasChanged();

        try
        {
            var response = await _http.GetAsync("/Configuration/GetRuntimeSettings");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<RuntimeSettingsDto>>();
                if (apiResponse?.Success ?? false)
                {
                    _runtimeSettings = apiResponse.Data ?? new RuntimeSettingsDto();
                }
                else
                {
                    _runtimeErrorMessage = apiResponse?.ErrorMessage ?? "Failed to load runtime settings";
                }
            }
            else
            {
                _runtimeErrorMessage = $"Server error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing runtime settings");
            _runtimeErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isRuntimeLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveRuntimeSettings()
    {
        _isRuntimeLoading = true;
        _runtimeErrorMessage = null;
        _runtimeSuccessMessage = null;
        StateHasChanged();

        try
        {
            var updateDto = new RuntimeSettingsUpdateDto
            {
                ExternalHostUrl = _runtimeSettings.ExternalHostUrl,
                CookieExpireTimeMinutes = _runtimeSettings.CookieExpireTimeMinutes,
                AllowBasicAuthentication = _runtimeSettings.AllowBasicAuthentication,
                TelegramSettings = _runtimeSettings.TelegramSettings,
                BruteForceDetectionSettings = _runtimeSettings.BruteForceDetectionSettings,
                MotionDetectionSettings = _runtimeSettings.MotionDetectionSettings,
                VideoRecordingSettings = _runtimeSettings.VideoRecordingSettings
            };

            var response = await _http.PostAsJsonAsync("/Configuration/UpdateRuntimeSettings", updateDto);
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();
                if (apiResponse?.Success ?? false)
                {
                    _runtimeSuccessMessage = "Runtime settings saved successfully!";
                    await RefreshRuntimeSettings();
                }
                else
                {
                    _runtimeErrorMessage = apiResponse?.ErrorMessage ?? "Failed to save settings";
                }
            }
            else
            {
                _runtimeErrorMessage = $"Server error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving runtime settings");
            _runtimeErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isRuntimeLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshCameraList()
    {
        try
        {
            var response = await _http.PostAsync("/Camera/RefreshCameraList", null);
            if (response.IsSuccessStatusCode)
            {
                _systemSuccessMessage = "Camera list refresh initiated. Please wait a few seconds for cameras to be discovered.";
                _currentUserState.Cameras = await _http.GetFromJsonAsync<List<CameraDto>>("/Camera/GetCameraList");
            }
            else
            {
                _systemErrorMessage = $"Failed to refresh camera list: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing camera list");
            _systemErrorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task RestartServer()
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Confirm Server Restart",
            "Are you sure you want to restart the server? All active recordings and connections will be interrupted.",
            yesText: "Restart",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                var response = await _http.PostAsync("/System/Restart", null);
                _systemSuccessMessage = "Server restart initiated. Please wait and refresh the page in a few seconds.";
            }
            catch (Exception)
            {
                _systemSuccessMessage = "Server restart command sent. The page will reload shortly...";
            }
        }
    }

    private async void OnLogin(UserInfoModel? userInfo)
    {
        try
        {
            if (IsAdmin())
            {
                await RefreshSystemSettings();
                await RefreshRuntimeSettings();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during login refresh");
        }
    }

    private void OnLogout()
    {
        _systemSettings = new SystemSettingsDto();
        _runtimeSettings = new RuntimeSettingsDto();
        StateHasChanged();
    }

    public void Dispose()
    {
        _authenticationService.OnLogIn -= OnLogin;
        _authenticationService.OnLogOut -= OnLogout;
    }
}


