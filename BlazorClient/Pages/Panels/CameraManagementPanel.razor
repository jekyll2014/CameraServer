@using System.Net
@using System.Net.Http.Json
@using CameraServer.Client.Services
@using CameraServer.Shared
@using CameraServer.Shared.DTO

@inject HttpClient _http
@inject IAuthenticationService _authenticationService
@inject ICurrentUserState _currentUserState
@inject ILogger<CameraManagementPanel> Logger

<MudPaper Class="pa-4">
    <MudStack Spacing="4">
        <!-- Camera List Section -->
        <MudPaper Elevation="2" Class="pa-3">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h5">Camera List</MudText>
                <MudStack Row="true" Spacing="2">
                    @if (IsAdmin())
                    {
                        <MudButton OnClick="@ClickedRefresh"
                                   Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="@_isLoading">
                            Refresh List
                        </MudButton>
                    }
                    <MudButton OnClick="@(() => _showVideoStream = !_showVideoStream)"
                               Variant="Variant.Filled"
                               StartIcon="@(_showVideoStream ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Videocam)"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               Disabled="@(_currentUserState.SelectedCamera == null)">
                        @(_showVideoStream ? "Hide Stream" : "Show Stream")
                    </MudButton>
                </MudStack>
            </MudStack>

            <MudDivider Class="my-3" />

            @if (_isLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                <MudAlert Severity="Severity.Info" Class="mt-3">
                    <MudText Typo="Typo.body2">
                        <strong>⏳ Refreshing camera list...</strong> 
                        This may take a few moments while cameras are being discovered.
                        <strong>All interactions are temporarily disabled.</strong>
                    </MudText>
                </MudAlert>
            }
            else if (_errorMessage != null)
            {
                <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">
                    @_errorMessage
                </MudAlert>
            }
            else
            {
                <MudStack Row="true" Spacing="4">
                    <!-- Camera Grid -->
                    <div style="@(_showVideoStream && _currentUserState.SelectedCamera != null ? "flex: 1;" : "width: 100%;")">
                        <MudDataGrid T="CameraDto"
                                     Items="@((_currentUserState.Cameras?.OrderBy(n => n.Name) ?? Enumerable.Empty<CameraDto>()).ToList())"
                                     ReadOnly="true"
                                     Outlined="true"
                                     Dense="true"
                                     Hover="@(!_isLoading)"
                                     Striped="true"
                                     RowClick="@ClickedCameraRow"
                                     RowStyleFunc="@CameraRowStyleFunc"
                                     Style="@(_isLoading ? "opacity: 0.6; pointer-events: none;" : "")">
                            <NoRecordsContent>
                                <MudText Color="Color.Info">No cameras found.</MudText>
                            </NoRecordsContent>

                            <Columns>
                                <PropertyColumn Property="c => c.Name" Title="Name" Sortable="true" />

                                <TemplateColumn Title="Resolution" Sortable="false">
                                    <CellTemplate>
                                        @if (context.Item.MaxFrameFormat != null)
                                        {
                                            <MudText>@context.Item.MaxFrameFormat.Width x @context.Item.MaxFrameFormat.Height</MudText>
                                        }
                                        else
                                        {
                                            <MudText Color="Color.Secondary">N/A</MudText>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>

                                <PropertyColumn Property="c => c.Type" Title="Type" Sortable="true" />

                                <TemplateColumn Title="PTZ" Sortable="true">
                                    <CellTemplate>
                                        <MudChip T="string" Size="Size.Small" Color="@(context.Item.IsPtz ? Color.Success : Color.Default)">
                                            @(context.Item.IsPtz ? "Yes" : "No")
                                        </MudChip>
                                    </CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="Actions" Sortable="false">
                                    <CellTemplate>
                                        <MudStack Row="true" Spacing="1">
                                            <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="@(() => ViewCamera(context.Item))"
                                                           Disabled="@_isLoading"
                                                           Title="View Stream" />
                                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                           Color="Color.Secondary"
                                                           Size="Size.Small"
                                                           Href="@context.Item.Url"
                                                           Disabled="@_isLoading"
                                                           Target="_blank"
                                                           Title="Open in New Tab" />
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    </div>

                    <!-- Video Stream Iframe -->
                    @if (_showVideoStream && _currentUserState.SelectedCamera != null)
                    {
                        <MudPaper Elevation="3" Class="pa-3" Style="flex: 1; min-width: 400px;">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.h6">@_currentUserState.SelectedCamera.Name</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   OnClick="@(() => _showVideoStream = false)" />
                                </MudStack>

                                <iframe src="@GetCurrentStreamUrl()"
                                        style="width: 100%; height: 500px; border: 2px solid #ddd; border-radius: 4px;"
                                        frameborder="0"
                                        allow="autoplay">
                                </iframe>

                                <!-- Stream Format Selector -->
                                <MudSelect T="FrameFormatDto"
                                           @bind-Value="_selectedFormat"
                                           Label="Stream Quality"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           ToStringFunc="@(f => f == null ? "Original" : $"{f.Width}x{f.Height} @ {f.Fps}fps")">
                                    <MudSelectItem T="FrameFormatDto" Value="null">Original Quality</MudSelectItem>
                                    @if (_currentUserState.SelectedCamera.FrameFormats != null)
                                    {
                                        @foreach (var format in _currentUserState.SelectedCamera.FrameFormats.OrderByDescending(f => f.Width * f.Height))
                                        {
                                            <MudSelectItem Value="@format">
                                                @($"{format.Width} x {format.Height} @@ {format.Fps} fps")
                                            </MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
        </MudPaper>

        <!-- Camera Details Section -->
        @if (_isLoading)
        {
            <MudPaper Elevation="2" Class="pa-3">
                <MudAlert Severity="Severity.Warning">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.body2">
                            <strong>Camera Refresh in Progress</strong>
                        </MudText>
                        <MudText Typo="Typo.caption">
                            Camera information is being updated. Selected camera details are temporarily hidden.
                            Please wait for the refresh to complete.
                        </MudText>
                        <MudProgressLinear Color="Color.Warning" Indeterminate="true" Class="mt-2" />
                    </MudStack>
                </MudAlert>
            </MudPaper>
        }
        else if (_currentUserState.SelectedCamera != null)
        {
            <MudPaper Elevation="2" Class="pa-3">
                <MudText Typo="Typo.h6" Class="mb-3">Camera Details</MudText>

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudField Label="Camera Name" Variant="Variant.Outlined">
                            @_currentUserState.SelectedCamera.Name
                        </MudField>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudField Label="Type" Variant="Variant.Outlined">
                            @_currentUserState.SelectedCamera.Type
                        </MudField>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudField Label="PTZ Support" Variant="Variant.Outlined">
                            @(_currentUserState.SelectedCamera.IsPtz ? "Yes" : "No")
                        </MudField>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudField Label="Path" Variant="Variant.Outlined">
                            @_currentUserState.SelectedCamera.Path
                        </MudField>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- PTZ Controls -->
            @if (_currentUserState.SelectedCamera.IsPtz)
            {
                <MudPaper Elevation="2" Class="pa-3">
                    <MudText Typo="Typo.h6" Class="mb-3">PTZ Controls</MudText>

                    <MudGrid Justify="Justify.Center">
                        <MudItem xs="12" Class="d-flex justify-center">
                            <MudStack Spacing="1" AlignItems="AlignItems.Center">
                                <MudButton OnClick="@ClickedPtzUp"
                                           Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.ArrowUpward"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           Disabled="@_isLoading">
                                    Up
                                </MudButton>

                                <MudStack Row="true" Spacing="1">
                                    <MudButton OnClick="@ClickedPtzLeft"
                                               Variant="Variant.Filled"
                                               StartIcon="@Icons.Material.Filled.ArrowBack"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               Disabled="@_isLoading">
                                        Left
                                    </MudButton>

                                    <div style="width: 60px;"></div>

                                    <MudButton OnClick="@ClickedPtzRight"
                                               Variant="Variant.Filled"
                                               StartIcon="@Icons.Material.Filled.ArrowForward"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               Disabled="@_isLoading">
                                        Right
                                    </MudButton>
                                </MudStack>

                                <MudButton OnClick="@ClickedPtzDown"
                                           Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.ArrowDownward"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           Disabled="@_isLoading">
                                    Down
                                </MudButton>
                            </MudStack>
                        </MudItem>

                        <MudItem xs="12" Class="d-flex justify-center mt-4">
                            <MudStack Row="true" Spacing="2">
                                <MudButton OnClick="@ClickedPtzZoomIn"
                                           Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.ZoomIn"
                                           Size="Size.Small"
                                           Color="Color.Secondary"
                                           Disabled="@_isLoading">
                                    Zoom In
                                </MudButton>

                                <MudButton OnClick="@ClickedPtzZoomOut"
                                           Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.ZoomOut"
                                           Size="Size.Small"
                                           Color="Color.Secondary"
                                           Disabled="@_isLoading">
                                    Zoom Out
                                </MudButton>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
            else
            {
                <MudPaper Elevation="2" Class="pa-3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.body1">PTZ control is not available for this camera.</MudText>
                        <MudButton OnClick="@ReCheckPtz"
                                   Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Size="Size.Small"
                                   Disabled="@_isLoading">
                            Re-check PTZ
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }
        }
    </MudStack>
</MudPaper>

@code {
    private bool _isLoading = false;
    private string? _errorMessage;
    private bool _showVideoStream = false;
    private FrameFormatDto? _selectedFormat = null;
    private string? _selectedCameraPath = null; // Use Path instead of Id (stable identifier)

    protected override async Task OnInitializedAsync()
    {
        _authenticationService.OnLogIn += OnLogin;
        _authenticationService.OnLogOut += OnLogout;

        // Check if server is currently refreshing (handles page refresh during refresh)
        await CheckAndWaitForRefreshCompletion();

        if (_currentUserState.Cameras == null)
            await LoadCameras();
    }

    /// <summary>
    /// Checks server refresh status on component initialization.
    /// If refresh is in progress, waits for completion (handles page refresh scenario).
    /// </summary>
    private async Task CheckAndWaitForRefreshCompletion()
    {
        try
        {
            // Check current server status
            var statusResponse = await _http.GetAsync("/Camera/GetCameraRefreshStatus");
            if (statusResponse.IsSuccessStatusCode)
            {
                var statusJson = await statusResponse.Content.ReadAsStringAsync();
                var statusData = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(statusJson);
                
                bool isRefreshing = statusData.GetProperty("isRefreshing").GetBoolean();
                
                // If refresh is in progress, wait for it
                if (isRefreshing)
                {
                    _isLoading = true;
                    _errorMessage = null;
                    StateHasChanged();
                    
                    Logger.LogInformation("Server refresh detected on page load, waiting for completion...");
                    await PollRefreshStatus();
                }
            }
        }
        catch (Exception ex)
        {
            // Silently handle - might not be able to reach status endpoint on init
            Logger.LogDebug($"Error checking refresh status on init: {ex.Message}");
        }
    }

    private async Task LoadCameras()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var previousSelectedPath = _currentUserState.SelectedCamera?.Path;

            _currentUserState.Cameras = await _http.GetFromJsonAsync<List<CameraDto>>("/Camera/GetCameraList");

            // Restore selected camera by matching Path (stable identifier)
            if (!string.IsNullOrEmpty(previousSelectedPath) && _currentUserState.Cameras != null)
            {
                _currentUserState.SelectedCamera = _currentUserState.Cameras
                    .FirstOrDefault(c => c.Path == previousSelectedPath);
            }
            else
            {
                _currentUserState.SelectedCamera = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading cameras");
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ClickedCameraRow(DataGridRowClickEventArgs<CameraDto> args)
    {
        if (_isLoading) return; // Block interaction during refresh

        _currentUserState.SelectedCamera = args.Item;
        _selectedCameraPath = args.Item.Path; // Store Path instead of Id
        _selectedFormat = null; // Reset format when changing camera
        StateHasChanged();
    }

    private void ViewCamera(CameraDto camera)
    {
        if (_isLoading) return; // Block interaction during refresh

        _currentUserState.SelectedCamera = camera;
        _selectedCameraPath = camera.Path;
        _showVideoStream = true;
        _selectedFormat = null;
        StateHasChanged();
    }

    private string GetCurrentStreamUrl()
    {
        if (_currentUserState.SelectedCamera == null)
            return string.Empty;

        var width = _selectedFormat?.Width ?? 0;
        var height = _selectedFormat?.Height ?? 0;
        var format = _selectedFormat?.Format ?? "";

        // Use camera path as identifier instead of volatile Id
        return $"/Camera/GetVideoContent?cameraId={_currentUserState.SelectedCamera.Id}&xResolution={width}&yResolution={height}&format={format}&quality=90";
    }

    private async Task ClickedRefresh()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var response = await _http.PostAsync("/Camera/RefreshCameraList", null);
            if (response.IsSuccessStatusCode)
            {
                // Refresh command accepted - now poll for completion
                await PollRefreshStatus();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                // Refresh already in progress
                _errorMessage = "Camera refresh is already in progress. Please wait for it to complete.";
                _isLoading = false;
                StateHasChanged();
            }
            else
            {
                _errorMessage = $"Failed to refresh: {response.StatusCode}";
                _isLoading = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing camera list");
            _errorMessage = $"Error: {ex.Message}";
            _isLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Polls the server for refresh status until it completes.
    /// Updates camera list when refresh finishes.
    /// </summary>
    private async Task PollRefreshStatus()
    {
        const int maxWaitTime = 300000; // 5 minutes max wait
        const int pollInterval = 1000;  // Poll every 1 second
        var elapsed = 0;

        try
        {
            while (elapsed < maxWaitTime)
            {
                // Check if refresh is still in progress
                var statusResponse = await _http.GetAsync("/Camera/GetCameraRefreshStatus");
                if (statusResponse.IsSuccessStatusCode)
                {
                    var statusJson = await statusResponse.Content.ReadAsStringAsync();
                    var statusData = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(statusJson);
                    
                    bool isRefreshing = statusData.GetProperty("isRefreshing").GetBoolean();
                    
                    if (!isRefreshing)
                    {
                        // Refresh completed on server - load updated camera list
                        Logger.LogInformation("Server refresh completed, loading cameras...");
                        await LoadCameras();
                        return;
                    }
                }

                // Wait before next poll
                await Task.Delay(pollInterval);
                elapsed += pollInterval;
            }

            // Timeout - give up polling but still try to load cameras
            Logger.LogWarning("Refresh polling timeout after 5 minutes");
            _errorMessage = "Refresh took too long. Camera list may be partially updated.";
            await LoadCameras();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error polling refresh status");
            _errorMessage = $"Error during refresh: {ex.Message}";
            _isLoading = false;
            StateHasChanged();
        }
    }

    private bool IsAdmin()
    {
        return _authenticationService.UserInfo?.Roles?.Contains("Admin") ?? false;
    }

    private async Task ClickedPtzUp() => await MovePtz(0, 100, 0);
    private async Task ClickedPtzDown() => await MovePtz(0, -100, 0);
    private async Task ClickedPtzLeft() => await MovePtz(100, 0, 0);
    private async Task ClickedPtzRight() => await MovePtz(-100, 0, 0);
    private async Task ClickedPtzZoomIn() => await MovePtz(0, 0, 100);
    private async Task ClickedPtzZoomOut() => await MovePtz(0, 0, -100);

    private async Task MovePtz(int xSpeed = 0, int ySpeed = 0, int zoomSpeed = 0, int delay = 100)
    {
        if (_currentUserState.SelectedCamera == null || _isLoading)
            return;

        try
        {
            var response = await _http.PostAsync(
                $"/Camera/MoveCameraPtz?cameraId={_currentUserState.SelectedCamera.Id}&xSpeed={xSpeed}&ySpeed={ySpeed}&zoomSpeed={zoomSpeed}&delay={delay}",
                null);

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = $"PTZ command failed: {response.StatusCode}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error moving PTZ");
            _errorMessage = $"Error: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ReCheckPtz()
    {
        if (_currentUserState.SelectedCamera == null || _isLoading)
            return;

        try
        {
            var response = await _http.PostAsync($"/Camera/ReCheckPtz?cameraId={_currentUserState.SelectedCamera.Id}", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadCameras();
            }
            else
            {
                _errorMessage = $"Failed to re-check PTZ: {response.StatusCode}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error re-checking PTZ");
            _errorMessage = $"Error: {ex.Message}";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Row styling - uses camera Path (stable) instead of Id (volatile)
    /// </summary>
    private Func<CameraDto, int, string> CameraRowStyleFunc => (camera, _) =>
    {
        var isSelected = _currentUserState.SelectedCamera?.Path == camera.Path;
        return isSelected
            ? "background-color: var(--mud-palette-primary-lighten); cursor: pointer; opacity: 1;"
            : "cursor: pointer; opacity: " + (_isLoading ? "0.5" : "1") + ";"; // Dim when loading
    };

    private async void OnLogin(UserInfoModel? userInfo)
    {
        try
        {
            await LoadCameras();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during login refresh");
        }
    }

    private void OnLogout()
    {
        _currentUserState.Cameras = null;
        _currentUserState.SelectedCamera = null;
        _selectedCameraPath = null;
        _showVideoStream = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        _authenticationService.OnLogIn -= OnLogin;
        _authenticationService.OnLogOut -= OnLogout;
    }
}

